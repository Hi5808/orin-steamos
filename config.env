# Build configuration for "SteamOS-style" Jetson Orin Nano image (P1)
L4T_RELEASE="39.2.1"
L4T_URL_BASE="https://developer.download.nvidia.com/embedded/L4T/r39_Release_v2.1/release"
BSP_TARBALL="Jetson_Linux_R39.2.1_aarch64.tbz2"
ROOTFS_TARBALL="Tegra_Linux_Sample-Root-Filesystem_R39.2.1_aarch64.tbz2"
SHA_FILE="release_sha_hashes.txt"

BOARD="jetson-orin-nano-devkit-super"   # flash target name (r39.2 Quick Start)

STEAM_USER="steamos"
HOSTNAME_TARGET="orin-steamos"

# Desktop for "Switch to Desktop": xfce (default, light) or none
DESKTOP="xfce"
# Install gamescope + an optional (non-default) gamescope session for P2 testing
WITH_GAMESCOPE=1

# Space needed (GiB) before we start
MIN_FREE_GB=16   # measured: downloads 3.1G + work tree 8.8G; +4G more for 'release'

# SSH (key-only) authorized key for the steamos user
SSH_AUTHORIZED_KEY=""   # (removed before publishing; see later commits)
# Install tailscale (NOT logged in, no auth keys)
WITH_TAILSCALE=1
# Password for steamos (sudo) is generated and written to SECRETS.txt (0600)
