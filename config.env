# shellcheck shell=bash
# Build configuration for the orin-steamos image (Jetson Orin Nano, JetPack 7.2.1).
# Every value can be overridden from the environment, e.g.
#   sudo PREINSTALL_STEAM=0 HOSTNAME_TARGET=mybox ./build.sh
# (sudo keeps variables given on its own command line like this.)

# --- NVIDIA Jetson Linux r39.2.1 (downloaded at build time, never committed) ---
: "${L4T_RELEASE:=39.2.1}"
: "${L4T_URL_BASE:=https://developer.download.nvidia.com/embedded/L4T/r39_Release_v2.1/release}"
: "${BSP_TARBALL:=Jetson_Linux_R39.2.1_aarch64.tbz2}"
: "${ROOTFS_TARBALL:=Tegra_Linux_Sample-Root-Filesystem_R39.2.1_aarch64.tbz2}"
: "${SHA_FILE:=release_sha_hashes.txt}"   # NVIDIA's published sha1 list (also checked)
# sha256 pins, measured on the r39.2.1 files downloaded 2026-10-16. A mismatch stops the build.
: "${BSP_SHA256:=2e5619088ba88e85dab25247f033d70659b6f676ff835176a07766dcb0fdbe6b}"
: "${ROOTFS_SHA256:=58a6485b56c6d6b5ee8478e902eed0ed4984fd73135b88b76aeaa5c1f44be66e}"

: "${BOARD:=jetson-orin-nano-devkit-super}"   # flash target name (r39.2 Quick Start)

# --- Image identity ---
: "${STEAM_USER:=steamos}"
: "${HOSTNAME_TARGET:=orin-steamos}"

# --- SSH (key-only login for $STEAM_USER) ---
# A file with one or more public keys. Default: the invoking user's ~/.ssh/id_ed25519.pub
# (the user who ran sudo). Nothing is hardcoded in this repo.
: "${SSH_AUTHORIZED_KEYS:=}"
# Set to 1 to build without any SSH key (console login only).
: "${ALLOW_NO_SSH_KEY:=0}"

# --- Steam ---
# 1 = download Valve's ARM64 Steam client bootstrap from Valve's CDN at build time and
#     put it in /home/$STEAM_USER/.local/share/Steam (for images you build and flash yourself).
# 0 = ship no Valve files; the device downloads Steam on first boot (use this for any image
#     you redistribute; see README.md "Licensing").
: "${PREINSTALL_STEAM:=1}"

# --- Optional components ---
: "${DESKTOP:=xfce}"          # desktop for "Switch to Desktop": xfce or none
: "${WITH_GAMESCOPE:=1}"      # gamescope runtime helpers + experimental gamescope session (P2)
: "${WITH_TAILSCALE:=1}"      # install tailscale (NOT logged in, daemon disabled, no auth key)
: "${PURGE_DESKTOP_EXTRAS:=1}" # purge snapd, gnome-remote-desktop, deja-dup from NVIDIA's rootfs

# --- Controller / input kernel modules ---
# NVIDIA's r39.2.1 kernel (6.8.12-*-tegra) has no uinput, hid-steam, hid-playstation,
# hid-nintendo or hid-sony. 1 = build them at image build time from upstream Linux sources
# against the image's own kernel headers (installed to /lib/modules/<krel>/updates/steamos-orin).
: "${WITH_INPUT_MODULES:=1}"
: "${KSRC_VERSION:=6.8.12}"
: "${KSRC_URL:=https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.8.12.tar.xz}"
: "${KSRC_SHA256:=19b31956d229b5b9ca5671fa1c74320179682a3d8d00fc86794114b21da86039}"

# --- Host requirements ---
: "${MIN_FREE_GB:=16}"        # measured: downloads 3.1G + work tree 8.8G; +4G for 'release'
