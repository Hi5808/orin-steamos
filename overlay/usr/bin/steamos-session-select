#!/bin/bash
# SteamOS-compatible session switcher for Jetson Orin.
#   plasma                       one-time desktop (what Steam's "Switch to Desktop" calls):
#                                desktop now, Game Mode again after the next reboot (as on SteamOS)
#   desktop | xfce | plasma-persistent | desktop-persistent
#                                persistent desktop: every boot goes to the desktop until changed
#   gamescope | gamemode | game  back to Game Mode (the "Return to Gaming Mode" shortcut)
#   steam-gamescope              the gamescope session (the default Game Mode)
#   gamemode-x11                 the X11 kiosk Game Mode, persistently
#   x11-fallback                 the X11 kiosk Game Mode for this boot only (used by the
#                                gamescope session when gamescope cannot start)
# Works from Game Mode, the desktop, or an SSH shell as the Steam user (polkit allows the
# helper without an authentication agent).
set -euo pipefail
# shellcheck source=/dev/null
[[ -r /etc/default/steamos-orin ]] && . /etc/default/steamos-orin

req="${1:-gamescope}"
mode=persistent
case "$req" in
    plasma)                                               target="${DESKTOP_SESSION_FILE:-xfce.desktop}"; mode=oneshot ;;
    desktop|xfce|plasma-persistent|desktop-persistent)   target="${DESKTOP_SESSION_FILE:-xfce.desktop}" ;;
    gamescope|gamemode|game)                              target="${GAMEMODE_SESSION_FILE:-steam-gamescope.desktop}" ;;
    steam-gamescope)                                      target="steam-gamescope.desktop" ;;
    gamemode-x11|steam-gamemode)                          target="${GAMEMODE_FALLBACK_SESSION_FILE:-steam-gamemode.desktop}" ;;
    x11-fallback)                                         target="${GAMEMODE_FALLBACK_SESSION_FILE:-steam-gamemode.desktop}"; mode=oneshot ;;
    *) echo "!! Unrecognized session '$req'" >&2; exit 1 ;;
esac

# Ask Steam to exit cleanly first (ignore if it is not running)
if [[ $EUID -ne 0 ]] && pgrep -u "$USER" -x steam >/dev/null 2>&1; then
    "$HOME/.local/share/Steam/steamrtarm64/steam" -shutdown >/dev/null 2>&1 || true
    for _ in $(seq 1 20); do pgrep -u "$USER" -x steam >/dev/null || break; sleep 0.5; done
fi

helper=/usr/bin/steamos-polkit-helpers/steamos-set-session
if [[ $EUID -eq 0 ]]; then exec "$helper" "$target" "$mode"; fi
exec pkexec --disable-internal-agent "$helper" "$target" "$mode"
