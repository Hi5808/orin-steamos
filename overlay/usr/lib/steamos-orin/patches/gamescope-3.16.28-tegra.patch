diff --git a/src/main.cpp b/src/main.cpp
index 0bd0cb4..6cced86 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -1119,6 +1119,12 @@ int main(int argc, char **argv)
 
 	gamescope::Process::KillAllChildren( getpid(), SIGTERM );
 	gamescope::Process::WaitForAllChildren();
+
+	// steamos-orin: skip static destructors at exit. ~CVulkanDevice joins the shader compile
+	// thread, which segfaults inside the NVIDIA (Tegra) shader compiler once exit handlers run.
+	fflush( stdout );
+	fflush( stderr );
+	_exit( 0 );
 }
 
 static void steamCompMgrThreadRun(int argc, char **argv)
