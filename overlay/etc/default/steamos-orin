# Extra arguments for the Steam client in Game Mode
STEAM_EXTRA_ARGS=""
# Desktop session used by "Switch to Desktop"
DESKTOP_SESSION_FILE="xfce.desktop"
# Session used for Game Mode ("steam-gamemode.desktop" = X11 kiosk, P1;
# "steam-gamescope.desktop" = experimental gamescope session, P2)
GAMEMODE_SESSION_FILE="steam-gamemode.desktop"
# gamescope session tuning (P2 experiments)
GAMESCOPE_BACKEND="drm"          # drm | wayland (nested, needs a compositor)
GAMESCOPE_OUTPUT_W=1920
GAMESCOPE_OUTPUT_H=1080
GAMESCOPE_EXTRA_ARGS=""
# Fast-crash protection: after N crashes within WINDOW seconds fall back to desktop
STEAM_CRASH_LIMIT=5
STEAM_CRASH_WINDOW=120
